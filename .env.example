# Alamat email kontak yang ditampilkan di halaman Kebijakan Privasi.
# Nilai VITE_* di-inline ke bundle publik saat build (bukan rahasia).
# Salin file ini ke .env.local dan isi email aslimu; set juga di Vercel
# (Settings > Environment Variables) untuk produksi.
VITE_CONTACT_EMAIL=kontak@sprtan.app
